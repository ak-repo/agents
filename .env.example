# Copy to .env and fill in. .env is git-ignored; this example file is committed.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional (default shown). Must support tool calling. Run `make models` to list free ones.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: SQLite file location (default: expenses.db in the project folder)
# EXPENSE_DB=expenses.db
